# Runtime
NODE_ENV=development
PLEDGEDRIVE_HOST=127.0.0.1
PLEDGEDRIVE_PORT=8787
PLEDGEDRIVE_USER_ID=operator-account
PLEDGEDRIVE_DATA_DIR=./data
PLEDGEDRIVE_STATE_FILE=./data/state.json
PLEDGEDRIVE_WEB_ROOT=./dist/apps/web/public
PLEDGEDRIVE_MAX_UPLOAD_BYTES=104857600
PLEDGEDRIVE_SESSION_TTL_SECONDS=604800

# In production use: openssl rand -base64 32
PLEDGEDRIVE_MASTER_KEY=replace-with-a-32-byte-base64-key
# At least 32 random characters in production; omit for local development.
PLEDGEDRIVE_API_TOKEN=
PLEDGEDRIVE_ALLOWED_ORIGIN=

# Reserved for the PostgreSQL/Redis adapters.
DATABASE_URL=postgresql://pledgedrive:change-me@localhost:5432/pledgedrive
REDIS_URL=redis://localhost:6379
